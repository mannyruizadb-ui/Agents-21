# Names only. Never commit values. Local: copy to supabase/functions/.env (gitignored) for
# `npx supabase functions serve`; cloud: `npx supabase secrets set NAME=value`.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# manage-users and sign-in
ALLOWED_ORIGINS=
# Password pepper (≥ 32 chars; deploy-db generates 64 hex chars once). Shared by sign-in and manage-users.
# Never rotate casually: a new value makes every stored password wrong (everyone needs a reset).
SIGN_IN_PEPPER=

# sign-in (optional)
# The header the platform sets with the caller's IP (e.g. cf-connecting-ip, or x-forwarded-for:1 = the
# rightmost entry). Empty = no per-IP limit (the per-login lock still applies). Set only after checking
# the diagnostic below.
SIGN_IN_TRUSTED_IP_HEADER=
# on = log once per function instance which IP headers arrive (names only, never values).
SIGN_IN_HEADER_DIAGNOSTIC=
# off = no one-time upgrade of passwords set before the pepper (default on).
SIGN_IN_LEGACY_UPGRADE=

# send-alerts (generate the pair with: node scripts/generate-vapid-keys.ts)
SEND_ALERTS_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
