-- Named fixture ids, usable inside SQL run as any role.
create function pg_temp.id(p text) returns uuid language sql immutable as $$
  select (case p
    when 'owner'         then 'aaaaaaaa-0000-0000-0000-000000000001'
    when 'manager'       then 'aaaaaaaa-0000-0000-0000-000000000002'
    when 'lead'          then 'aaaaaaaa-0000-0000-0000-000000000003'
    when 'viewer'        then 'aaaaaaaa-0000-0000-0000-000000000004'
    when 'display'       then 'aaaaaaaa-0000-0000-0000-000000000005'
    when 'ownerB'        then 'aaaaaaaa-0000-0000-0000-000000000006'
    when 'nobody'        then 'aaaaaaaa-0000-0000-0000-000000000007'
    when 'display_nodev' then 'aaaaaaaa-0000-0000-0000-000000000008'
    when 'display_split' then 'aaaaaaaa-0000-0000-0000-00000000000a'   -- memberships added per test
    when 'a2viewer'      then 'aaaaaaaa-0000-0000-0000-00000000000b'
    when 'ownerP'        then 'aaaaaaaa-0000-0000-0000-00000000000c'
    when 'orgA'          then '10000000-0000-0000-0000-00000000000a'
    when 'orgB'          then '10000000-0000-0000-0000-00000000000b'
    when 'plantA'        then '20000000-0000-0000-0000-00000000000a'
    when 'plantB'        then '20000000-0000-0000-0000-00000000000b'
    when 'plantA2'       then '20000000-0000-0000-0000-00000000000c'
    when 'washA2'        then '30000000-0000-0000-0000-0000000000c1'
    when 'itemA2'        then '70000000-0000-0000-0000-0000000000c1'
    when 'wash'          then '30000000-0000-0000-0000-0000000000a1'
    when 'fin'           then '30000000-0000-0000-0000-0000000000a2'
    when 'spare'         then '30000000-0000-0000-0000-0000000000a3'
    when 'washB'         then '30000000-0000-0000-0000-0000000000b1'
    when 'device'        then '40000000-0000-0000-0000-0000000000a1'
    when 'station'       then '50000000-0000-0000-0000-0000000000a1'
    when 'machine'       then '60000000-0000-0000-0000-0000000000a1'
    when 'napkin'        then '70000000-0000-0000-0000-0000000000a1'
    when 'mat'           then '70000000-0000-0000-0000-0000000000a2'
    when 'towel'         then '70000000-0000-0000-0000-0000000000a3'
    when 'itemB'         then '70000000-0000-0000-0000-0000000000b1'
    when 'formula'       then '80000000-0000-0000-0000-0000000000a1'
    when 'finEvening'    then '90000000-0000-0000-0000-0000000000f1'
    when 'finNight'      then '90000000-0000-0000-0000-0000000000f3'
    when 'finDay'        then '90000000-0000-0000-0000-0000000000f5'
    when 'washEvening'   then '90000000-0000-0000-0000-0000000000e1'
    when 'washNight'     then '90000000-0000-0000-0000-0000000000e3'
  end)::uuid;
$$;

-- Role switching. Claims carry the user id; role authenticated (or anon) runs the statement.
create function pg_temp.login(p_uid uuid) returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', p_uid, 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;
create function pg_temp.login_anon() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  perform set_config('role', 'anon', true);
end;
$$;

-- Runs p_sql as the named fixture user ('anon' = anon role) in a subtransaction, then returns to
-- postgres. Result: row count (p_count: rows the query returns; else rows affected), or on error
-- the app code (P0001 message, e.g. VALIDATION_FAILED) or the SQLSTATE (e.g. 42501, 23514).
create function pg_temp.run_as(p_user text, p_sql text, p_count boolean default false)
returns text language plpgsql as $$
declare
  n bigint;
begin
  if p_user = 'anon' then
    perform pg_temp.login_anon();
  else
    perform pg_temp.login(pg_temp.id(p_user));
  end if;
  if p_count then
    execute 'select count(*) from (' || p_sql || ') x' into n;
  else
    execute p_sql;
    get diagnostics n = row_count;
  end if;
  reset role;
  return n::text;
exception when others then
  return case when sqlstate = 'P0001' then sqlerrm else sqlstate end;
end;
$$;

-- §4.7 matrix order: owner, manager, lead, viewer, display, display without device, owner of
-- tenant B, anon.
create function pg_temp.reads(p_sql text) returns text[] language sql as $$
  select array_agg(pg_temp.run_as(u, p_sql, true) order by o)
    from unnest(array['owner','manager','lead','viewer','display','display_nodev','ownerB','anon'])
         with ordinality as r(u, o);
$$;
create function pg_temp.writes(p_sql text) returns text[] language sql as $$
  select array_agg(pg_temp.run_as(u, p_sql, false) order by o)
    from unnest(array['owner','manager','lead','viewer','display','display_nodev','ownerB','anon'])
         with ordinality as r(u, o);
$$;

-- Local-time helper: plant-local timestamp text → timestamptz.
create function pg_temp.ny(p text) returns timestamptz language sql immutable as $$
  select (p::timestamp) at time zone 'America/New_York';
$$;
-- Shift instance id by area, shift name and business date.
create function pg_temp.si(p_area uuid, p_name text, p_date date) returns uuid language sql stable as $$
  select si.id from public.shift_instances si join public.shifts s on s.id = si.shift_id
   where si.area_id = p_area and s.name = p_name and si.business_date = p_date;
$$;
grant execute on function pg_temp.id(text), pg_temp.login(uuid), pg_temp.login_anon(),
  pg_temp.ny(text), pg_temp.si(uuid, text, date) to authenticated, anon;
